# 环境变量配置示例
# 复制此文件为 .env.local 并填入实际的配置值
# 所有变量均需在对应平台的环境变量管理界面中配置，不要将实际值提交到版本控制。

# ==================== 认证与安全 ====================

# 用于 HMAC-SHA256 签名的密钥，保护同步接口防止越权访问
# 生产环境必须设置，建议使用 32 位以上随机字符串
# 生成命令: openssl rand -hex 32
AUTH_SECRET=your_auth_secret_here

# AI 代理接口每 IP 每分钟最大请求数（可选，默认 60）
PROXY_RATE_LIMIT=60

# ==================== 数据库配置（Vercel/Netlify 云端同步） ====================
# Cloudflare Pages 使用 KV 存储，无需以下数据库配置，请参考 README 中的 KV 配置说明。

# 数据库类型: mysql 或 postgres
DB_TYPE=mysql

# 数据库主机地址
DB_HOST=your-database-host.example.com

# 数据库端口（MySQL 默认 3306，PostgreSQL 默认 5432）
DB_PORT=3306

# 数据库名称
DB_NAME=aipibox_sync

# 数据库用户名
DB_USER=your_db_username

# 数据库密码
DB_PASSWORD=your_db_password

# 连接池大小（可选，默认 10）
DB_CONNECTION_LIMIT=10

# 是否启用 SSL 连接（生产环境推荐设为 true）
DB_SSL=true

# 是否关闭 SSL 证书校验（仅限受控内网环境，生产环境不建议设为 false）
DB_SSL_REJECT_UNAUTHORIZED=true

# ==================== 推荐的数据库服务商 ====================

# 1. PlanetScale（MySQL，免费层可用）
#    DB_TYPE=mysql
#    DB_HOST=xxx.connect.psdb.cloud
#    DB_USER=xxx
#    DB_PASSWORD=pscale_pw_xxx
#    DB_SSL=true

# 2. Supabase（PostgreSQL，免费层可用）
#    DB_TYPE=postgres
#    DB_HOST=db.xxx.supabase.co
#    DB_PORT=5432
#    DB_USER=postgres
#    DB_PASSWORD=your_password
#    DB_NAME=postgres
#    DB_SSL=true

# 3. Railway（MySQL/PostgreSQL，免费层可用）
#    从 Railway 项目控制台获取数据库连接信息

# 4. Neon（PostgreSQL，免费层可用）
#    DB_TYPE=postgres
#    DB_HOST=xxx.neon.tech
#    DB_SSL=true
