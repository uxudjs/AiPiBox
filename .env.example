# Cloudflare Pages 环境变量示例
# 请在 Pages 项目设置中配置真实值，不要将密钥提交到版本控制。

# 用于 HMAC-SHA256 签名，生产环境必须设置。
# 建议使用至少 32 字节的随机值，例如：openssl rand -hex 32
AUTH_SECRET=your_auth_secret_here

# AI 代理接口每个 IP 每分钟的最大请求数（可选，默认 60）。
PROXY_RATE_LIMIT=60

# SYNC_DATA 不是环境变量。
# 请在 Pages 项目的 Functions > KV namespace bindings 中，
# 将 Cloudflare KV 命名空间绑定为 SYNC_DATA。
